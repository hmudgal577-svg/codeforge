# ============================================
# CodeForge Environment Configuration
# ============================================

# App
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://codeforge:codeforge_secret@localhost:5432/codeforge?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://codeforge:codeforge_secret@localhost:5672

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# AI / OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o
AI_ENABLED=false

# Docker Execution
DOCKER_SOCKET=/var/run/docker.sock
EXECUTION_TIMEOUT=30000
EXECUTION_MEMORY_LIMIT=128m
EXECUTION_CPU_LIMIT=0.5

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# CORS
CORS_ORIGINS=http://localhost:3000
